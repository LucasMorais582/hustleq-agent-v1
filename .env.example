OPENAI_API_KEY=
DATABASE_URL=

# Meet Duke demo (src/demo)
# hustleq-social-data-api base URL, and its API key once it requires one (sent as x-api-key)
SOCIAL_DATA_API_URL=
# Same value as JWT_SECRET (and JWT_ISSUER / JWT_AUDIENCE, if changed) on the social-data-api.
SOCIAL_DATA_JWT_SECRET=
SOCIAL_DATA_JWT_ISSUER=
SOCIAL_DATA_JWT_AUDIENCE=
# Optional: comma-separated origins allowed to call /demo (defaults to the landing domains + localhost)
DEMO_ALLOWED_ORIGINS=
# Optional limits (defaults shown)
DEMO_MAX_PROFILE_LOOKUPS_PER_DAY=500
DEMO_PROFILE_LIMIT_PER_15MIN=60
DEMO_IDEA_LIMIT_PER_15MIN=60
DEMO_REFRESH_CONCURRENCY=3

# --- HustleQ MVP (branch mvp-v1) ---
# Same Supabase database as DATABASE_URL, MVP tables in their own schema.
MVP_DATABASE_URL="postgresql://...pooler.supabase.com:5432/postgres?pgbouncer=true&schema=mvp"
# Only for `npm test` (local): a separate schema that tests migrate and fill.
MVP_TEST_DATABASE_URL="postgresql://...pooler.supabase.com:5432/postgres?pgbouncer=true&schema=mvp_test"
# Comma-separated origins allowed to call /v1 (the app's URL).
APP_ORIGINS="http://localhost:5173"
# fake | demo  (demo = the Meet Duke profile endpoint; "api" once Helio's endpoints exist)
SOCIAL_DATA_MODE="fake"
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Test login created by `npm run mvp:seed`
MVP_SEED_EMAIL="teste@hustleq.test"
MVP_SEED_PASSWORD=
# off = do not run the job worker in this process
JOBS_WORKER=
