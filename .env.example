OPENAI_API_KEY=
DATABASE_URL=

# Meet Duke demo (src/demo)
# hustleq-social-data-api base URL, and its API key once it requires one (sent as x-api-key)
SOCIAL_DATA_API_URL=
# Same value as JWT_SECRET (and JWT_ISSUER / JWT_AUDIENCE, if changed) on the social-data-api.
SOCIAL_DATA_JWT_SECRET=
SOCIAL_DATA_JWT_ISSUER=
SOCIAL_DATA_JWT_AUDIENCE=
# Optional: comma-separated origins allowed to call /demo (defaults to the landing domains + localhost)
DEMO_ALLOWED_ORIGINS=
# Optional limits (defaults shown)
DEMO_MAX_PROFILE_LOOKUPS_PER_DAY=500
DEMO_PROFILE_LIMIT_PER_15MIN=60
DEMO_IDEA_LIMIT_PER_15MIN=60
DEMO_REFRESH_CONCURRENCY=3
