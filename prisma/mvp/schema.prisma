// HustleQ MVP data model (branch mvp-v1).
// Lives in the Postgres schema "mvp" (see MVP_DATABASE_URL); the demo and the beta keep "public".
// Instagram data is not stored here: it belongs to the Social Data API. We keep only the profile id
// and the link planned post -> published post.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/mvp"
}

// MVP_DATABASE_URL: Supabase transaction pooler (port 6543, pgbouncer=true, connection_limit) for the app.
// MVP_DIRECT_URL: session connection (port 5432) for migrations. The session pooler allows only 15 clients
// for the whole project (demo + MVP + jobs), so the app must not use it for queries.
datasource db {
  provider  = "postgresql"
  url       = env("MVP_DATABASE_URL")
  directUrl = env("MVP_DIRECT_URL")
}

// ---------- Account and access ----------

enum Role {
  user
  admin
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String
  role                  Role      @default(user)
  timezone              String    @default("America/New_York")
  instagramProfileId    String?   @unique
  instagramHandle       String?
  socialProfileId       String?   @unique // profile id in the Social Data API, set once we own it there
  socialMonitoringUntil DateTime? // last value sent to the Social Data API (null = always collect)
  termsAcceptedAt       DateTime?
  termsVersion          String?
  billingExempt         Boolean   @default(false) // accounts the HustleQ team manages (FPP): always active, no Stripe
  remindersOn           Boolean   @default(true) // email on post days (Account · Reminders)
  reminderTime          String    @default("09:00") // when the reminder goes out, owner's timezone
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions        Session[]
  resetTokens     PasswordResetToken[]
  business        BusinessProfile?
  onboarding      OnboardingState?
  conversations   Conversation[]
  aiUsage         AiUsage[]
  strategies      Strategy[]
  weeks           Week[]
  posts           Post[]
  campaigns       Campaign[]
  userDates       UserCommercialDate[]
  notes           Note[]
  savedPosts      SavedPost[]
  watchedAccounts WatchedAccount[]
  milestones      Milestone[]
  monthlyReviews  MonthlyReview[]
  suggestions     Suggestion[]
  subscription    Subscription?
  usage           Usage[]
  limitRenewals   LimitRenewal[]
  refreshUsage    RefreshUsage[]
  credits         Credit[]
  shotLists       ShotList[]
  exports         Export[]
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

model Invite {
  id                 String       @id @default(uuid())
  email              String
  businessName       String
  instagramHandle    String
  instagramProfileId String?
  socialProfileId    String? // reserved in the Social Data API for this invite
  firstAccess        Boolean      @default(false) // Duke First Access: first month free
  billingExempt      Boolean      @default(false) // managed by the HustleQ team: no Stripe
  tokenHash          String       @unique
  status             InviteStatus @default(pending)
  expiresAt          DateTime
  lastReminderAt     DateTime?
  createdById        String
  acceptedUserId     String?
  acceptedAt         DateTime?
  createdAt          DateTime     @default(now())

  @@index([email])
  @@index([status, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminId      String
  action       String
  targetUserId String?
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId])
}

// Every email the app sends (or would send, without a provider). Also stops duplicates:
// one invite reminder per day, one "last day" email per invite.
model EmailLog {
  id         String   @id @default(uuid())
  to         String
  template   String // invite | invite_reminder | invite_last_day | invite_expired | password_reset
  subject    String
  refId      String? // invite id, user id...
  status     String // sent | logged | failed
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([refId, template])
}

// ---------- Business ----------

model BusinessProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  businessName     String
  // The 9 fields of the spec (2.4 / 13.7), in this order.
  whatYouDo        String?
  niche            String?
  location         String?
  offers           String?
  idealCustomer    String?
  customerProblem  String?
  customerChannels String?
  doNotPost        String?
  goals            String?
  completedAt      DateTime? // set by "Looks good"
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingState {
  userId         String    @id
  step           Int       @default(1) // 1 Instagram, 2 summary, 3 questions, 4 review and first strategy
  status         String    @default("active") // active | paused (Not my account) | done
  conversationId String?
  data           Json? // analysis, current question, sub-state
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Last profile + recent posts read for a handle (own account). Refreshed at most once a day.
model InstagramCache {
  handle    String   @id
  profileId String
  data      Json
  source    String
  fetchedAt DateTime @default(now())
}

// "Not my account" during onboarding: the team checks and fixes the handle.
model AccountChangeRequest {
  id              String    @id @default(uuid())
  userId          String
  currentHandle   String?
  requestedHandle String
  status          String    @default("open") // open | resolved
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([status])
}

// ---------- Duke ----------

model Conversation {
  id         String   @id @default(uuid())
  userId     String
  title      String?
  pinned     Boolean  @default(false)
  objectType String? // week | strategy | campaign | note | onboarding | reminders | review
  objectId   String?
  summary    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  toolCalls ToolCall[]

  @@index([userId, updatedAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String // user | assistant
  // Content blocks exactly as the Claude API returned them (thinking blocks included):
  // the history must go back append-only, or preserved thinking breaks.
  content        Json
  // What the app renders: text plus cards.
  display        Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ToolCall {
  id             String   @id @default(uuid())
  conversationId String
  name           String
  input          Json
  output         Json?
  status         String // ok | blocked | error
  durationMs     Int?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AiUsage {
  id               String   @id @default(uuid())
  userId           String?
  feature          String // chat | week_skeleton | post_details | ...
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Decimal  @db.Decimal(10, 6)
  durationMs       Int?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ---------- Plan ----------

model Strategy {
  id             String    @id @default(uuid())
  userId         String
  title          String // the strategy's name, e.g. "Taste the Tradition"
  objective      String?
  durationWeeks  Int       @default(8)
  staticPerWeek  Int       @default(2) // feed posts and carousels
  videosPerWeek  Int       @default(2) // Reels
  storiesPerWeek Int       @default(3)
  status         String    @default("draft") // draft | saved (active/ended comes from the dates)
  startsOn       DateTime? @db.Date
  endsOn         DateTime? @db.Date
  conversationId String? // where it was created ("Open conversation")
  summary        String?
  goals          Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pillars Pillar[]
  weeks   Week[]

  @@index([userId])
}

model Pillar {
  id          String  @id @default(uuid())
  strategyId  String
  name        String
  baseType    String? // attract | educate | trust | sell | community | entertain | custom
  description String?
  goal        String? // "Goal: 20 new followers"
  share       Int?
  position    Int     @default(0)

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  posts    Post[]
}

model Week {
  id             String   @id @default(uuid())
  userId         String
  strategyId     String?
  startsOn       DateTime @db.Date // Monday, in the owner's timezone
  status         String   @default("draft") // draft | saved
  bestTime       String? // "19:00", from the last posts' engagement
  conversationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  posts    Post[]
  shotList ShotList?

  @@index([userId, startsOn])
}

enum PostStatus {
  draft
  scheduled
  posted
  cancelled
}

model Post {
  id                 String     @id @default(uuid())
  userId             String
  weekId             String?
  pillarId           String?
  campaignId         String?
  conversationId     String? // the chat it was created in, for posts outside a week or campaign
  status             PostStatus @default(draft)
  scheduledAt        DateTime?
  format             String? // reel | carousel | feed | story
  contentType        String? // static | video | story (counts per week follow the strategy)
  title              String?
  hook               String?
  caption            String?
  position           Int        @default(0)
  // Full details (5.2b), written in the background after the skeleton.
  idea               Json? // { hook, goal, funnelStage }
  captionParts       Json? // { hook, body, callToAction }
  hashtags           String[]
  creativeDirection  Json? // visualConcept, openingImpact, visualNarrative, mood, colorAndType, audienceEmotion, platformElements, execution
  productionGuidance Json? // objective, recordingPlan, editing, assets, checklist
  postingReminders   String[]
  detailsStatus      String     @default("pending") // pending | ready | failed
  reminderEmail      Boolean    @default(true)
  reminderSentAt     DateTime?
  timeSuggested      Boolean    @default(true) // "· suggested" until the owner sets the time
  note               String?
  dismissedMatches   String[] // Instagram post ids the owner said aren't this post (6.4 "No, different post")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  week        Week?            @relation(fields: [weekId], references: [id], onDelete: SetNull)
  pillar      Pillar?          @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  campaign    Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  media       PostMedia[]
  validations PostValidation[]
  publication PostPublication?

  @@index([userId, scheduledAt])
}

model PostMedia {
  id          String   @id @default(uuid())
  postId      String
  storagePath String
  kind        String   @default("image") // image | video
  framePaths  String[] // for a video: a few still frames taken in the browser, for validation
  mimeType    String
  sizeBytes   Int
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostValidation {
  id        String   @id @default(uuid())
  postId    String
  result    Json
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostPublication {
  id              String   @id @default(uuid())
  postId          String   @unique
  instagramPostId String // id in the Social Data API
  confirmedAt     DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// ---------- Production ----------

model ShotList {
  id            String   @id @default(uuid())
  userId        String
  weekId        String   @unique
  status        String   @default("pending") // pending | ready | failed
  title         String? // "Film everything in one session"
  summary       String?
  importantNote String?
  sessions      Int      @default(1)
  people        String[]
  locations     String[]
  assets        String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  week  Week           @relation(fields: [weekId], references: [id], onDelete: Cascade)
  items ShotListItem[]
}

model ShotListItem {
  id         String  @id @default(uuid())
  shotListId String
  postId     String?
  text       String
  stage      String  @default("filming") // before | filming | after
  done       Boolean @default(false)
  position   Int     @default(0)

  shotList ShotList @relation(fields: [shotListId], references: [id], onDelete: Cascade)
}

model Export {
  id        String   @id @default(uuid())
  userId    String
  linkId    String   @unique
  kind      String // week | strategy | campaign
  objectId  String
  include   Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Calendar ----------

model Campaign {
  id             String   @id @default(uuid())
  userId         String
  name           String
  goal           String?
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  color          String
  status         String   @default("draft") // draft | saved (upcoming / active / ended come from the dates)
  dateId         String? // CommercialDate id, or UserCommercialDate id for the owner's own dates
  strategyId     String?
  objective      String?
  conversationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId])
}

model CommercialDate {
  id      String   @id @default(uuid())
  name    String
  date    DateTime @db.Date
  country String   @default("US")
  niches  String[]
  tip     String? // shown in 7.5 when there's no campaign yet, e.g. "Good for gift cards and pre-orders"

  @@unique([name, date])
}

model UserCommercialDate {
  id               String    @id @default(uuid())
  userId           String
  commercialDateId String?
  name             String?
  date             DateTime? @db.Date
  notThisYear      Boolean   @default(false) // on a CommercialDate row: "Not this year"
  skippedYear      Int? // the year "Not this year" applies to
  repeats          Boolean   @default(false) // own date: every year
  suggestCampaign  Boolean   @default(true) // own date: Duke suggests a campaign 3 to 4 weeks before
  source           String    @default("own") // own (added by the owner) | niche (Duke, from the niche)
  reviewStatus     String    @default("approved") // niche dates: approved (shown) | rejected (hidden by the team)
  tip              String? // niche dates: why it fits this business
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Ideas ----------

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  text      String
  source    String   @default("manual") // chat | post_idea | manual | explore
  postId    String? // the post it turned into
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  references NoteReference[]

  @@index([userId])
}

model NoteReference {
  id              String   @id @default(uuid())
  noteId          String
  instagramPostId String?
  url             String?
  kind            String   @default("own") // own (your post) | explore
  label           String? // "@bahiataste · your post"
  thumbnailUrl    String?
  createdAt       DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

model SavedPost {
  id              String   @id @default(uuid())
  userId          String
  instagramPostId String
  source          String   @default("explore") // explore | watched | own
  data            Json? // the post as shown when saved (Discover results expire)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, instagramPostId])
}

// ---------- Explore ----------

model WatchedAccount {
  id                 String    @id @default(uuid())
  userId             String
  instagramProfileId String
  handle             String
  label              String // competitor | inspiration
  minUntil           DateTime? // cannot be removed before this date
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, instagramProfileId])
}

model ExploreCache {
  id        String   @id @default(uuid())
  key       String   @unique // niche|city or term
  data      Json
  fetchedAt DateTime @default(now())
}

// ---------- Review ----------

// 12.4 · Timeline: "Started with HustleQ", then one per monthly review (what changed).
model Milestone {
  id        String   @id @default(uuid())
  userId    String
  kind      String // start | review
  date      DateTime @db.Date
  title     String // "Started with HustleQ", "December review"
  items     String[] // "Goals: added holiday catering orders"
  reviewId  String?  @unique
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// 12.0 to 12.3 · Monthly review. month = the 1st of the month it opens (it looks back at the month before).
model MonthlyReview {
  id             String    @id @default(uuid())
  userId         String
  month          DateTime  @db.Date
  status         String    @default("preparing") // preparing | ready | active | done
  analysis       Json? // numbers + Duke's summary, insights and "For <month>"
  facts          Json? // what the analysis was written from
  batchId        String? // Message Batch that prepares the analysis on day 1
  conversationId String?
  step           Int       @default(0) // 0 analysis, 1-5 the questions, 6 done
  data           Json? // sub-state and the changes so far
  preparedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([status])
}

model Suggestion {
  id          String    @id @default(uuid())
  userId      String
  kind        String // campaign | empty_day | monthly_review | strategy
  payload     Json?
  status      String    @default("open") // open | shown | accepted | dismissed
  createdAt   DateTime  @default(now())
  dismissedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ---------- Billing and limits ----------

model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  status               String    @default("none") // Stripe's status: none | trialing | active | past_due | canceled | unpaid | incomplete ...
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  cancelReason         String?
  firstAccess          Boolean   @default(false)
  graceUntil           DateTime? // payment failed: still active until this moment (3 days)
  endedAt              DateTime?
  syncedAt             DateTime?
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Usage {
  id          String   @id @default(uuid())
  userId      String
  kind        String // heavy_generation | validation | search | watch_slot
  periodStart DateTime @db.Date
  count       Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodStart])
}

model LimitRenewal {
  id              String   @id @default(uuid())
  userId          String
  kind            String
  stripePaymentId String?
  stripeSessionId String?  @unique // one renewal per Checkout session
  amountCents     Int      @default(2000)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshUsage {
  id                 String   @id @default(uuid())
  userId             String
  instagramProfileId String
  day                DateTime @db.Date // in the account's timezone
  count              Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, instagramProfileId, day])
}

model Credit {
  id          String    @id @default(uuid())
  userId      String
  amountCents Int
  source      String // first_access
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
